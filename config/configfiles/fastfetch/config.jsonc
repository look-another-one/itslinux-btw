{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "chafa",
        "source": "",
        "width": 40,
        "height": 20,
        "padding": {
            "top": 1
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "key": "╭───────────╮",
            "type": "custom"
        },
        {
            "key": "│ {#31} user     {#keys}│",
            "type": "title",
            "format": "{user-name}"
        },
        {
            "key": "│ {#32}󰇅 hname   {#keys}│",
            "type": "title",
            "format": "{host-name}"
        },
        {
            "type": "command",
            "key": "│ {#33}󱦟 os age  {#keys}│",
            "keyColor": "magenta",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); days=$(((current - birth_install) / 86400)); echo $days days"
        },
        {
            "key": "│ {#34}󰅐 uptime  {#keys}│",
            "type": "uptime"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#34}{icon} distro  {#keys}│",
            "type": "os"
        },
        {
            "key": "│ {#35} kernel   {#keys}│",
            "type": "kernel"
        },
        {
            "key": "│ {#36} wm       {#keys}│",
            "type": "wm"
        },
        {
            "key": "│ {#31} term     {#keys}│",
            "type": "terminal"
        },
        {
            "key": "│ {#32} shell    {#keys}│",
            "type": "shell"
        },
        {
            "key": "│ {#33}󰏗 pkgs    {#keys}│",
            "type": "packages"
        },
        {
            "key": "│ {#34}󰖲 display {#keys}│",
            "type": "display",
            "compact": true
        },
        {
            "key": "│ {#35}󰃰 locale  {#keys}│",
            "type": "locale"
        },
        {
            "key": "│ {#36}󰚢 init    {#keys}│",
            "type": "command",
            "text": "ps --no-headers -o comm 1"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#33}󰍛 cpu     {#keys}│",
            "type": "cpu",
            "showPeCoreCount": true
        },
        {
            "key": "│ {#34}󰓅 cpu use {#keys}│",
            "type": "cpuusage"
        },
        {
            "key": "│ {#35}󰾲 gpu     {#keys}│",
            "type": "gpu"
        },
        {
            "key": "│ {#36}󰉉 disk    {#keys}│",
            "type": "disk",
            "folders": "/"
        },
        {
            "key": "│ {#31} memory   {#keys}│",
            "type": "memory"
        },
        {
            "key": "│ {#32}󰾴 swap    {#keys}│",
            "type": "swap"
        },
        {
            "key": "│ {#33}󰒋 procs   {#keys}│",
            "type": "processes"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#34}󰤨 wifi    {#keys}│",
            "type": "wifi"
        },
        {
            "key": "│ {#35}󰈀 net     {#keys}│",
            "type": "localip",
            "showIpv4": true,
            "showIpv6": false,
            "compact": true
        },
        {
            "key": "│ {#36}󱈏 batt    {#keys}│",
            "type": "battery"
        },
        {
            "key": "│ {#31}󰔔 theme   {#keys}│",
            "type": "theme"
        },
        {
            "key": "│ {#32}󱎨 cursor  {#keys}│",
            "type": "cursor"
        },
        {
            "key": "│ {#33}󰸶 icons   {#keys}│",
            "type": "icons"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#39} colors   {#keys}│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╰───────────╯",
            "type": "custom"
        }
    ]
}