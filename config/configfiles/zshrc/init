# -----------------------------------------------------
# INIT
# -----------------------------------------------------

# -----------------------------------------------------
# Exports
# -----------------------------------------------------
export EDITOR=nvim
# Global .env file
ENV_FILE="$HOME/.env"

if [[ -f "$ENV_FILE" ]]; then
    set -a
    source "$ENV_FILE"
    set +a
fi

# -----------------------------------------------------
# Alias 
# -----------------------------------------------------
alias ls="eza  --icons=always"
alias lsa="nu -c ls"
alias la='eza -a --icons=always'
alias ll='eza -al --icons=always'
alias lt='eza -a --tree --level=1 --icons=always'
